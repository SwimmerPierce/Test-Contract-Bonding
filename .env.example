# Copy this file to .env (which is gitignored) for local development.
# In production on Vercel, set these in Vercel Project Settings -> Environment Variables.

# Vercel Neon Postgres Connection String (provision production DB in aws-ca-central-1 / Montreal)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# Admin Dashboard Logins for /admin (20-character secure passwords per user)
ADMIN_PASSWORD_CHASE=<20-character-secure-password>
ADMIN_PASSWORD_KEN=<20-character-secure-password>
ADMIN_PASSWORD_NATHAN=<20-character-secure-password>

# Master fallback admin password
ADMIN_PASSWORD=<your-strong-admin-password>

# Transactional Email Alerts via Resend (https://resend.com)
RESEND_API_KEY=<your-resend-api-key>
ALERT_TO_EMAILS=chase@nexusinsurancebrokers.com,father@nexusinsurancebrokers.com
ALERT_FROM_EMAIL=Contract Bonding Portal <alerts@contractbonding.ca>
