# Copy this file to .env (which is gitignored) for local development.
# In production on Vercel, set these in Vercel Project Settings -> Environment Variables.

# Vercel Neon Postgres Connection String
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require

# Admin Dashboard Password for /admin (required — no default fallback in code)
ADMIN_PASSWORD=<your-strong-admin-password>
